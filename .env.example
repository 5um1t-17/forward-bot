# ============================================================
# Telegram Message Transfer Bot - configuration template
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env to version control.
# ============================================================

# Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=0
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# MongoDB connection string (defaults to local mongod)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=telegram_transfer_bot

# Comma separated numeric Telegram user IDs that get admin access
# e.g. ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Key used to encrypt stored Telethon sessions (Fernet).
# If left empty a key is generated on first run and stored in SESSION_KEY_FILE.
SESSION_ENCRYPTION_KEY=

# Where generated session key lives
SESSION_KEY_FILE=session.key

# Tuning defaults (can be changed per user in Settings)
DEFAULT_THREADS=2
DEFAULT_FORWARD_DELAY=0
