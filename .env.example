# --- Telegram API credentials (https://my.telegram.org/apps) ---
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC...            # from @BotFather

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=telegram_transfer_bot

# --- Optional ---
# Admin Telegram user ids (numeric), comma separated, for the global stats view
ADMIN_IDS=

# Session encryption key. If empty, a key is generated on first run and stored
# in session.key (mode 0600).
SESSION_ENCRYPTION_KEY=

# --- Tuning (optional) ---
# FETCH_DIALOGS_TIMEOUT=60
# CLIENT_CONNECT_TIMEOUT=25
# RECONNECT_DELAY=5
# LOG_DIR=logs
# SESSION_DIR=sessions
